#!/usr/bin/env bash
set -euo pipefail

# ============================================================
# 服务器运维自动化脚本
# 功能：磁盘备份 / 进程监控 / 资源告警 / 日志清理 / 健康检查
# ============================================================

readonly SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly LOG_FILE="/var/log/ops_monitor.log"
readonly ALERT_EMAIL="admin@example.com"
readonly SLACK_WEBHOOK="${SLACK_WEBHOOK_URL:-}"
readonly BACKUP_DIR="/backup"
readonly RETENTION_DAYS=7

# 阈值配置
readonly CPU_THRESHOLD=85
readonly MEM_THRESHOLD=90
readonly DISK_THRESHOLD=85
readonly LOAD_THRESHOLD=4.0

# 颜色输出
RED='\033[0;31m'; YELLOW='\033[1;33m'; GREEN='\033[0;32m'; NC='\033[0m'

log() { echo "[$(date '+%Y-%m-%d %H:%M:%S')] [$1] $2" | tee -a "$LOG_FILE"; }
info()    { log "INFO " "${GREEN}$*${NC}"; }
warn()    { log "WARN " "${YELLOW}$*${NC}"; }
error()   { log "ERROR" "${RED}$*${NC}"; }

send_alert() {
    local subject="$1" body="$2"
    warn "ALERT: $subject"
    if command -v mail &>/dev/null; then
        echo "$body" | mail -s "[OPS ALERT] $subject" "$ALERT_EMAIL" 2>/dev/null || true
    fi
    if [[ -n "$SLACK_WEBHOOK" ]]; then
        curl -s -X POST "$SLACK_WEBHOOK" \
            -H "Content-Type: application/json" \
            -d "{\"text\":\":rotating_light: *$subject*\n$body\"}" &>/dev/null || true
    fi
}

# ---- 磁盘使用检查 ----
check_disk() {
    info "Checking disk usage..."
    local alerts=0
    while IFS= read -r line; do
        local usage mount
        usage=$(echo "$line" | awk '{print $5}' | tr -d '%')
        mount=$(echo "$line" | awk '{print $6}')
        if [[ "$usage" -ge "$DISK_THRESHOLD" ]]; then
            send_alert "Disk Usage Critical: $mount" \
                "Disk $mount is at ${usage}% (threshold: ${DISK_THRESHOLD}%)"
            ((alerts++))
        fi
    done < <(df -h | tail -n +2 | grep -v "tmpfs\|devtmpfs")
    [[ $alerts -eq 0 ]] && info "Disk usage OK" || warn "$alerts disk alert(s) sent"
}

# ---- CPU 使用检查 ----
check_cpu() {
    info "Checking CPU usage..."
    local cpu_idle cpu_usage
    cpu_idle=$(top -bn1 | grep "Cpu(s)" | awk '{print $8}' | tr -d '%id,')
    cpu_usage=$(echo "100 - $cpu_idle" | bc 2>/dev/null || echo "0")
    local load
    load=$(uptime | awk -F'load average:' '{print $2}' | awk '{print $1}' | tr -d ',')
    info "CPU: ${cpu_usage}% | Load: $load"
    if (( $(echo "$cpu_usage > $CPU_THRESHOLD" | bc -l) )); then
        send_alert "High CPU Usage" "CPU is at ${cpu_usage}% (threshold: ${CPU_THRESHOLD}%)"
    fi
    if (( $(echo "$load > $LOAD_THRESHOLD" | bc -l) )); then
        send_alert "High System Load" "Load average is $load (threshold: $LOAD_THRESHOLD)"
    fi
}

# ---- 内存检查 ----
check_memory() {
    info "Checking memory usage..."
    local total used free usage
    total=$(free -m | awk '/^Mem:/{print $2}')
    used=$(free -m | awk '/^Mem:/{print $3}')
    usage=$(echo "scale=1; $used * 100 / $total" | bc)
    info "Memory: ${used}MB / ${total}MB (${usage}%)"
    if (( $(echo "$usage > $MEM_THRESHOLD" | bc -l) )); then
        local top_procs
        top_procs=$(ps aux --sort=-%mem | head -6 | awk '{print $1,$2,$3,$4,$11}')
        send_alert "High Memory Usage" \
            "Memory is at ${usage}% (threshold: ${MEM_THRESHOLD}%)\nTop processes:\n$top_procs"
    fi
}

# ---- 进程监控 ----
monitor_processes() {
    local services=("nginx" "mysql" "redis-server" "sshd")
    info "Monitoring critical processes..."
    for svc in "${services[@]}"; do
        if ! pgrep -x "$svc" &>/dev/null; then
            warn "Process $svc is NOT running! Attempting restart..."
            if systemctl is-enabled "$svc" &>/dev/null; then
                systemctl restart "$svc" && info "$svc restarted successfully" \
                    || send_alert "Service Down: $svc" "$svc failed to restart on $(hostname)"
            else
                send_alert "Process Down: $svc" "$svc is not running on $(hostname)"
            fi
        else
            info "  [OK] $svc is running (PID: $(pgrep -x "$svc" | head -1))"
        fi
    done
}

# ---- 数据库备份 ----
backup_databases() {
    info "Starting database backup..."
    local backup_date
    backup_date=$(date '+%Y%m%d_%H%M%S')
    local backup_path="$BACKUP_DIR/$backup_date"
    mkdir -p "$backup_path"

    if command -v mysqldump &>/dev/null; then
        local dbs
        dbs=$(mysql -N -e "SHOW DATABASES;" 2>/dev/null | grep -v "information_schema\|performance_schema\|sys" || echo "")
        for db in $dbs; do
            local out="$backup_path/${db}.sql.gz"
            mysqldump --single-transaction --routines --triggers "$db" 2>/dev/null | gzip > "$out"
            info "  Backed up: $db -> $out ($(du -sh "$out" | cut -f1))"
        done
    fi

    # 压缩整个备份目录
    tar -czf "${backup_path}.tar.gz" -C "$BACKUP_DIR" "$backup_date" && rm -rf "$backup_path"
    info "Backup complete: ${backup_path}.tar.gz"

    # 清理旧备份
    find "$BACKUP_DIR" -name "*.tar.gz" -mtime +"$RETENTION_DAYS" -delete
    info "Cleaned up backups older than $RETENTION_DAYS days"
}

# ---- 日志清理 ----
cleanup_logs() {
    info "Cleaning up old logs..."
    local freed=0
    while IFS= read -r f; do
        local size
        size=$(stat -c%s "$f" 2>/dev/null || echo 0)
        gzip -9 "$f" 2>/dev/null && freed=$((freed + size))
        info "  Compressed: $f"
    done < <(find /var/log -name "*.log" -not -name "*.gz" -mtime +1 -size +1M 2>/dev/null)
    find /var/log -name "*.gz" -mtime +30 -delete 2>/dev/null || true
    info "Log cleanup done. Freed approx $(echo "scale=2; $freed/1048576" | bc)MB"
}

# ---- HTTP 健康检查 ----
health_check_endpoints() {
    local endpoints=(
        "http://localhost:80/health"
        "http://localhost:8080/api/health"
        "http://localhost:3000/"
    )
    info "Running HTTP health checks..."
    for url in "${endpoints[@]}"; do
        local code
        code=$(curl -s -o /dev/null -w "%{http_code}" --connect-timeout 5 "$url" 2>/dev/null || echo "000")
        if [[ "$code" == "200" || "$code" == "204" ]]; then
            info "  [OK] $url ($code)"
        else
            warn "  [FAIL] $url returned $code"
            send_alert "Health Check Failed" "Endpoint $url returned HTTP $code on $(hostname)"
        fi
    done
}

# ---- 主流程 ----
main() {
    info "========== OPS Monitor Started =========="
    check_disk
    check_cpu
    check_memory
    monitor_processes
    health_check_endpoints
    if [[ "${1:-}" == "--backup" ]]; then
        backup_databases
    fi
    if [[ "${1:-}" == "--cleanup" ]]; then
        cleanup_logs
    fi
    info "========== OPS Monitor Finished =========="
}

main "$@"
